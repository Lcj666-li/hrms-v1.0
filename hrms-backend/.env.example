# 复制为 .env 后按本机环境修改；.env 不要提交到仓库
APP_NAME=HRMS 人事管理系统
DEBUG=true

# MySQL 连接串：mysql+pymysql://用户名:密码@主机:端口/数据库名?字符集
DATABASE_URL=mysql+pymysql://root:你的数据库密码@127.0.0.1:3306/hrms?charset=utf8mb4

# JWT 密钥：正式部署必须改成随机长字符串
JWT_SECRET_KEY=change-this-to-a-random-long-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 允许跨域的前端地址
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173