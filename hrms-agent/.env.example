# HRMS 业务后端（本机 8000）
HRMS_BASE_URL=http://127.0.0.1:8000
# 知擎知识库服务（制度问答用，没有就留空，工具会自动降级）
KB_BASE_URL=http://127.0.0.1:8080
KB_SUBJECT=

# LLM（留空则用规则 Planner，可离线跑通评测）
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# 预算闸门
AGENT_MAX_STEPS=4
AGENT_TIMEOUT=20
AGENT_MAX_TOKENS=8000
# 每用户每分钟请求上限
AGENT_RATE_LIMIT=30

# trace 落库（独立库 hrms_agent，不碰 HRMS 业务表）
AGENT_MYSQL_DSN=mysql+pymysql://root:123456@127.0.0.1:3306/hrms_agent?charset=utf8mb4

# 默认账号（本地演示用，正式环境走请求头 token）
HRMS_MANAGER_USER=manager
HRMS_MANAGER_PASSWORD=123456
HRMS_EMPLOYEE_USER=employee
HRMS_EMPLOYEE_PASSWORD=123456
